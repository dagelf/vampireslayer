#!/usr/bin/python3
"""Run the Omarchy plugin under a transient systemd user service."""
import argparse
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent
UNIT = 'vampireslayer.service'
ENVIRONMENT = ('DISPLAY', 'WAYLAND_DISPLAY', 'XDG_RUNTIME_DIR', 'DBUS_SESSION_BUS_ADDRESS',
               'XDG_CURRENT_DESKTOP', 'XDG_SESSION_TYPE', 'XAUTHORITY', 'XDG_CONFIG_HOME')


def unit_quote(value):
    if any(ord(c) < 32 for c in value):
        raise ValueError('Control characters are not supported in service paths')
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"').replace('$', '$$') + '"'


def service_command(root=ROOT, env=os.environ):
    backend = str(root / 'background-suspend')
    return ['systemd-run', '--user', '--unit=' + UNIT, '--collect',
            '--description=Vampire Slayer: background browser and app idle suspend',
            '--property=Type=exec', '--property=TimeoutStopSec=10',
            '--property=ExecStopPost=/usr/bin/python3 ' + unit_quote(backend) + ' resume',
            '--expand-environment=no',
            *['--setenv=' + key for key in ENVIRONMENT if env.get(key)],
            '/usr/bin/python3', backend, 'run', '--minutes', '15']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('start', 'stop'))
    args = parser.parse_args()
    if args.action == 'start':
        legacy = subprocess.run(['systemctl', '--user', 'is-active', '--quiet',
                                 'firefox-idle.service', 'background-suspend.service'])
        if legacy.returncode == 0:
            raise RuntimeError('A standalone idle watcher is active; stop it before enabling Vampire Slayer')
    # Wait for the previous instance's ExecStopPost before creating a new one.
    # A missing unit is normal on first enable; systemd-run reports other errors.
    subprocess.run(['systemctl', '--user', 'stop', UNIT], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=False)
    if args.action == 'start':
        subprocess.run(service_command(), check=True)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as error:
        import sys
        print(f'Vampire Slayer: {error}', file=sys.stderr)
        raise SystemExit(1)
